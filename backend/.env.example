# PulsarGuard backend configuration example
# Copy to .env for local development when the backend is implemented.
# Never put real credentials or secrets in this file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Local SQLite database
DATABASE_URL=sqlite:///./pulsarguard.db

# Allowed frontend origin for local development
CORS_ORIGINS=http://localhost:3000
